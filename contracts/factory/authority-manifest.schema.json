{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory.authority-manifest.schema/v1",
  "type": "object",
  "required": ["schemaVersion", "repository", "determinationStatuses", "documentStatuses", "sources", "promotionRules", "invariants"],
  "properties": {
    "schemaVersion": {"const": "factory.authority-manifest/v1"},
    "repository": {
      "type": "object",
      "required": ["id", "product", "baselineRef", "baselineCommit"]
    },
    "determinationStatuses": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "documentStatuses": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "status", "determinationStatus", "precedence", "scope", "governs", "provenance"]
      }
    },
    "retrievedReferences": {"type": "array"},
    "promotionRules": {"type": "array"},
    "invariants": {"type": "object"}
  }
}
